string standalone.ReturnLeadDetailOnCall(String crmAPIRequest)
{
ORG_ID = "org60043206528";
LEAD_CANVAS_ID = "973060000000717144";
CONTACT_CANVAS_ID = "973060000000496941";
details = Map();
// --- Unwrap request ---
req = Map();
try 
{
	req = ifnull(crmAPIRequest,"{}").toMap();
	bodyRaw = ifnull(req.get("body"),"{}");
}
catch (e)
{
	err = Map();
	err.put("code","error");
	err.put("message","Invalid wrapper payload");
	err.put("details",{"output_type":"string"});
	return err.toString();
}
// --- Parse JSON body ---
params = Map();
try 
{
	params = ifnull(bodyRaw,"{}").toMap();
}
catch (e)
{
	err = Map();
	err.put("code","error");
	err.put("message","Body parse error: " + e.toString());
	err.put("details",{"output_type":"string"});
	return err.toString();
}
// --- Inputs ---
mobile = ifnull(params.get("mobile"),"").trim();
callType = ifnull(params.get("type"),"").trim();
ownerEmail = ifnull(params.get("userEmail"),"").trim();
campaignID = ifnull(params.get("campaignID"),"").trim();
// recordID input is no longer used — Path A (direct recordID lookup) has been commented out
// recordID = ifnull(params.get("recordID"),"").trim();
// --- Resolve ownerID from ownerEmail (via COQL) ---
ownerID = null;
if(ownerEmail != "")
{
	try 
	{
		coqlBodyUser = Map();
		userQuery = "select id from users where email = '" + ownerEmail + "' limit 1";
		coqlBodyUser.put("select_query",userQuery);
		getUserInfo = invokeapi
		[
			service :zohocrm
			path :"crm/v7/coql"
			type :POST
			body:coqlBodyUser.toString()
		];
		usersData = ifnull(getUserInfo.get("data"),List());
		if(usersData != null && !usersData.isEmpty())
		{
			ownerID = ifnull(usersData.get(0).get("id"),null);
		}
	}
	catch (eU)
	{
		info "[OWNER LOOKUP] Error: " + eU.toString();
		ownerID = null;
	}
	if(ownerID == null)
	{
		info "[OWNER LOOKUP] No user found for email: " + ownerEmail;
		responseMap = Map();
		responseMap.put("Error","No User Found");
		responseMap.put("Code",404);
		return responseMap.toString();
	}
}
// --- Fetch Business Unit from Lead_Campaign via campaignID ---
businessUnit = "";
if(campaignID != "")
{
	try 
	{
		coqlBodyCamp = Map();
		campQuery = "select Business_Unit from Lead_Campaign where Campaign_ID = '" + campaignID + "' limit 1";
		coqlBodyCamp.put("select_query",campQuery);
		campaignResp = invokeapi
		[
			service :zohocrm
			path :"crm/v7/coql"
			type :POST
			body:coqlBodyCamp.toString()
		];
		campData = ifnull(campaignResp.get("data"),List());
		if(campData != null && !campData.isEmpty())
		{
			businessUnit = ifnull(campData.get(0).get("Business_Unit"),"");
		}
	}
	catch (e)
	{
		businessUnit = "";
		info "[CAMPAIGN LOOKUP] Error: " + e.toString();
	}
}
found = false;
entityType = "";
recordId = "";
ownerEmailFound = null;
userTeam = null;
recordUrl = null;
// -------------------------------------------------------
// PATH A: recordID direct lookup — COMMENTED OUT
// Now always using PATH B (COQL search by mobile + businessUnit)
// -------------------------------------------------------
/*
if(recordID != "")
{
	// --- Step 1A: Try fetching recordID as a Contact ---
	if(businessUnit != "")
	{
		try 
		{
			contactFetched = zoho.crm.getRecordById("Contacts",recordID);
			if(contactFetched != null && contactFetched.get("id") != null)
			{
				recordId = contactFetched.get("id").toString();
				entityType = "Contact";
				found = true;
				contactOwner = contactFetched.get("Owner");
				if(contactOwner != null)
				{
					contactOwnerId = ifnull(contactOwner.get("id"),null).toString();
					if(ownerID != null && contactOwnerId != null && contactOwnerId != ownerID)
					{
						linkRecord = {"Sharing_To":{"id":ownerID},"userlookup221_22":{"id":recordId}};
						zoho.crm.createRecord("Contacts_X_Users",linkRecord);
					}
					try 
					{
						ownerInformation = zoho.crm.getRecordById("users",contactOwnerId);
						ownerEmailFound = ownerInformation.get("users").getJSON("email");
					}
					catch (e)
					{
						info "[PATH A - Contact] Error fetching owner email: " + e.toString();
						ownerEmailFound = null;
					}
					userMaster = zoho.crm.searchRecords("User_Masters","User_CRM_ID:equals:" + contactOwnerId);
					userTeam = ifNull(userMaster.get(0).getJSON("Team"),null);
				}
				recordUrl = "https://crmplus.zoho.in/motilaloswalamc/index.do/cxapp/crm/" + ORG_ID + "/tab/Contacts/" + recordId + "/canvas/" + CONTACT_CANVAS_ID;
			}
		}
		catch (e)
		{
			info "[PATH A - Contact] Lookup failed: " + e.toString();
		}
	}
	// --- Step 2A: If not a Contact, try fetching recordID as a Lead ---
	if(!found)
	{
		try 
		{
			leadFetched = zoho.crm.getRecordById("Leads",recordID);
			if(leadFetched != null && leadFetched.get("id") != null)
			{
				recordId = leadFetched.get("id").toString();
				entityType = "Lead";
				found = true;
				leadOwner = leadFetched.get("Owner");
				if(leadOwner != null)
				{
					leadOwnerId = leadOwner.get("id").toString();
					if(ownerID != null && leadOwnerId != ownerID)
					{
						linkRecord = {"Sharing_To":{"id":ownerID},"userlookup221_21":{"id":recordId}};
						createShare = zoho.crm.createRecord("Leads_X_Users",linkRecord);
						nowTime = zoho.currenttime;
						addedtime = nowTime.addMinutes(30);
						nextActionIso = addedtime.toString("yyyy-MM-dd'T'HH:mm:ss");
						zoho.crm.updateRecord("Leads",recordId,{"Revoke_Again":nextActionIso},{"trigger":{"workflow"}});
					}
					try 
					{
						ownerInformation = zoho.crm.getRecordById("users",leadOwnerId);
						ownerEmailFound = ownerInformation.get("users").getJSON("email");
					}
					catch (e)
					{
						info "[PATH A - Lead] Error fetching owner email: " + e.toString();
						ownerEmailFound = null;
					}
				}
				userTeam = ifnull(leadFetched.get("Team"),null);
				recordUrl = "https://crmplus.zoho.in/motilaloswalamc/index.do/cxapp/crm/" + ORG_ID + "/tab/Leads/" + recordId + "/canvas/" + LEAD_CANVAS_ID;
			}
		}
		catch (e)
		{
			info "[PATH A - Lead] Lookup failed: " + e.toString();
		}
	}
}
*/
// -------------------------------------------------------
// PATH B: COQL search by mobile (+ businessUnit if available)
// businessUnit filter is applied only when it is non-empty;
// if campaignID was not provided (or did not resolve), the
// search falls back to mobile-only so no record is missed.
// -------------------------------------------------------
// --- Step 1B: Search Contacts by mobile (+ BU if present) via COQL ---
if(!found && mobile != "")
{
	try 
	{
		// Build WHERE clause — include Business_Unit filter only when resolved
		contactWhereClause = "Mobile = '" + mobile + "'";
		if(businessUnit != "")
		{
			contactWhereClause = contactWhereClause + " and Business_Unit = '" + businessUnit + "'";
		}
		contactQuery = "select id, Owner from Contacts where " + contactWhereClause + " limit 1";
		coqlBodyContacts = Map();
		coqlBodyContacts.put("select_query",contactQuery);
		contactsResp = invokeapi
		[
			service :zohocrm
			path :"crm/v7/coql"
			type :POST
			body:coqlBodyContacts.toString()
		];
		contactsList = ifnull(contactsResp.get("data"),List());
		if(contactsList != null && !contactsList.isEmpty())
		{
			contact = contactsList.get(0);
			recordId = contact.get("id").toString();
			entityType = "Contact";
			found = true;
			contactOwner = contact.get("Owner");
			if(contactOwner != null)
			{
				contactOwnerId = ifnull(contactOwner.get("id"),null).toString();
				if(ownerID != null && contactOwnerId != null && contactOwnerId != ownerID)
				{
					linkRecord = {"Sharing_To":{"id":ownerID},"userlookup221_22":{"id":recordId}};
					zoho.crm.createRecord("Contacts_X_Users",linkRecord);
				}
				try 
				{
					ownerInformation = zoho.crm.getRecordById("users",contactOwnerId);
					ownerEmailFound = ownerInformation.get("users").getJSON("email");
				}
				catch (e)
				{
					info "[PATH B - Contact] Error fetching owner email: " + e.toString();
					ownerEmailFound = null;
				}
				userMaster = zoho.crm.searchRecords("User_Masters","User_CRM_ID:equals:" + contactOwnerId);
				userTeam = ifNull(userMaster.get(0).getJSON("Team"),null);
			}
			recordUrl = "https://crmplus.zoho.in/motilaloswalamc/index.do/cxapp/crm/" + ORG_ID + "/tab/Contacts/" + recordId + "/canvas/" + CONTACT_CANVAS_ID;
		}
	}
	catch (e)
	{
		info "[PATH B - Contact] COQL search failed: " + e.toString();
	}
}
// --- Step 2B: If no Contact found, search Leads by mobile (+ BU if present) via COQL ---
if(!found && mobile != "")
{
	try 
	{
		// Build WHERE clause — include Business_Unit filter only when resolved
		leadWhereClause = "Mobile = '" + mobile + "'";
		if(businessUnit != "")
		{
			leadWhereClause = leadWhereClause + " and Business_Unit = '" + businessUnit + "'";
		}
		leadSelectQuery = "select id, Owner, Team from Leads where " + leadWhereClause + " limit 1";
		coqlBodyLeads = Map();
		coqlBodyLeads.put("select_query",leadSelectQuery);
		leadsResp = invokeapi
		[
			service :zohocrm
			path :"crm/v7/coql"
			type :POST
			body:coqlBodyLeads.toString()
		];
		leadsList = ifnull(leadsResp.get("data"),List());
		if(leadsList != null && !leadsList.isEmpty())
		{
			lead = leadsList.get(0);
			recordId = lead.get("id").toString();
			entityType = "Lead";
			found = true;
			leadOwner = lead.get("Owner");
			if(leadOwner != null)
			{
				leadOwnerId = leadOwner.get("id").toString();
				if(ownerID != null && leadOwnerId != ownerID)
				{
					linkRecord = {"Sharing_To":{"id":ownerID},"userlookup221_21":{"id":recordId}};
					createShare = zoho.crm.createRecord("Leads_X_Users",linkRecord);
					nowTime = zoho.currenttime;
					addedtime = nowTime.addMinutes(30);
					nextActionIso = addedtime.toString("yyyy-MM-dd'T'HH:mm:ss");
					zoho.crm.updateRecord("Leads",recordId,{"Revoke_Again":nextActionIso},{"trigger":{"workflow"}});
				}
				try 
				{
					ownerInformation = zoho.crm.getRecordById("users",leadOwnerId);
					ownerEmailFound = ownerInformation.get("users").getJSON("email");
				}
				catch (e)
				{
					info "[PATH B - Lead] Error fetching owner email: " + e.toString();
					ownerEmailFound = null;
				}
			}
			userTeam = ifnull(lead.get("Team"),null);
			recordUrl = "https://crmplus.zoho.in/motilaloswalamc/index.do/cxapp/crm/" + ORG_ID + "/tab/Leads/" + recordId + "/canvas/" + LEAD_CANVAS_ID;
		}
	}
	catch (e)
	{
		info "[PATH B - Lead] COQL search failed: " + e.toString();
	}
}
// -------------------------------------------------------
// PATH C: Still not found → create a new Lead
// -------------------------------------------------------
if(!found && mobile != "" && businessUnit != "")
{
	createPayload = Map();
	createPayload.put("First_Name",callType);
	createPayload.put("Last_Name",mobile.toString());
	createPayload.put("Business_Unit",businessUnit);
	createPayload.put("Mobile",mobile);
	createPayload.put("Lead_Prospect_Source","Manual");
	createPayload.put("Lead_Status","Open");
	createPayload.put("Lead_Source",callType.toLowerCase());
	if(ownerID != null)
	{
		createPayload.put("Owner",{"id":ownerID});
	}
	try 
	{
		createResp = zoho.crm.createRecord("Leads",createPayload,{"trigger":{"workflow"}});
		recordId = createResp.get("id").toString();
		entityType = "Lead";
		found = true;
		info "[PATH C] New Lead created → recordId: " + recordId;
		try 
		{
			newLeadFetched = zoho.crm.getRecordById("Leads",recordId,{"connection":"get_conn"});
			leadOwner = newLeadFetched.get("Owner");
			if(leadOwner != null)
			{
				leadOwnerId = leadOwner.get("id").toString();
				ownerResp = zoho.crm.getRecordById("users",leadOwnerId);
				info ownerResp;
				ownerEmailFound = ownerResp.get("users").getJSON("email");
				info ownerEmailFound;
			}
			userTeam = ifnull(newLeadFetched.get("Team"),null);
		}
		catch (e)
		{
			info "[PATH C] Error fetching new lead details: " + e.toString();
			ownerEmailFound = null;
			userTeam = null;
		}
		recordUrl = "https://crmplus.zoho.in/motilaloswalamc/index.do/cxapp/crm/" + ORG_ID + "/tab/Leads/" + recordId + "/canvas/" + LEAD_CANVAS_ID;
	}
	catch (e)
	{
		info "[PATH C] Lead creation failed: " + e.toString();
		err = Map();
		err.put("code","error");
		err.put("message","Lead creation failed");
		err.put("details",{"error":e.toString(),"output_type":"string"});
		return err.toString();
	}
}
// --- Build response ---
details.put("Module",entityType);
details.put("lead_id",recordId);
details.put("businessUnit",businessUnit);
if(ownerEmailFound != "zoho.implmentation@motilaloswal.com" && ownerEmailFound != "amc.zoho@motilaloswal.com")
{
	details.put("ownerEmail",ownerEmailFound);
}
else
{
	details.put("ownerEmail",null);
}
details.put("userTeam",userTeam);
details.put("leadUrl",recordUrl);
ok = Map();
if(found)
{
	ok.put("code","success");
}
else
{
	ok.put("code","not_found");
	info "[RESPONSE] not_found → no record matched and no Lead created";
}
ok.put("details",details);
return ok.toString();
}